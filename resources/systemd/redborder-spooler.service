[Unit]
Description=redBorder Spooler Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=redborder-spooler
Group=redborder-spooler
ExecStart=/usr/bin/rb-spooler record --config /etc/redborder-spooler/config.yaml
Restart=always
RestartSec=5s
RuntimeDirectory=redborder-spooler
RuntimeDirectoryMode=0755
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
